# Get External IP / Internet Speed
alias myip="curl https://ipinfo.io/json" # or /ip for plain-text ip
alias speedtest="curl -s https://raw.githubusercontent.com/sivel/speedtest-cli/master/speedtest.py | python3 -"

# Quickly serve the current directory as HTTP
alias serve='python3 -m http.server 8000'

# Herdr sessionizer shortcuts (names retained for muscle memory)
alias tms="~/bin/herdr-sessionizer"
alias tmd="~/bin/herdr-sessionizer ~/.local/share/chezmoi/home"
alias tmw="~/bin/herdr-sessionizer ~/work"
alias tmp="~/bin/herdr-sessionizer ~/personal"
alias tmv="~/bin/herdr-sessionizer ~/.config/nvim"
