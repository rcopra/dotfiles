# ==============================================================================
# Powerlevel10k instant prompt — must stay at the very top; anything that
# prints to the console during startup must run before this block
# ==============================================================================
# direnv's first sync can print (e.g. "direnv: unloading"), so it runs pre-preamble
command -v direnv > /dev/null && emulate zsh -c "$(direnv export zsh)"

if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ==============================================================================
# Environment Variables
# ==============================================================================
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export EDITOR=nvim
export BUNDLER_EDITOR=nvim
export HOMEBREW_NO_ANALYTICS=1
export MENUCONFIG_STYLE=monochrome

# Ruby
export DISABLE_SPRING=true
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

# Python (uv manages versions/venvs/tools — no shell hook needed)
export PYTHONBREAKPOINT=ipdb.set_trace

# ==============================================================================
# PATH Configuration
# ==============================================================================
typeset -U path PATH

# Homebrew (Apple Silicon)
export PATH="/opt/homebrew/bin:${PATH}"
export PATH="/opt/homebrew/opt/postgresql@16/bin:$PATH"

# Local binaries
export PATH="$HOME/bin:$HOME/.local/bin:$HOME/go/bin:$PATH"

export PATH="${PATH}:/usr/local/sbin"

# Play Date SDK builder
export PLAYDATE_SDK_PATH="$HOME/Developer/PlaydateSDK"
export PATH="$PLAYDATE_SDK_PATH/bin:$PATH"

# ==============================================================================
# History
# ==============================================================================
HISTFILE=$HOME/.zhistory
HISTSIZE=10000
SAVEHIST=10000
setopt extended_history       # timestamp + duration per entry
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_verify
setopt inc_append_history
setopt share_history

# ==============================================================================
# Directories
# ==============================================================================
setopt auto_cd auto_pushd pushd_ignore_dups
alias ..='cd ..'
alias ...='cd ../..'

# ==============================================================================
# Completions
# ==============================================================================
setopt auto_menu complete_in_word always_to_end
# (#q...) glob qualifiers in [[ ]] (compinit check below, gh-token cache in
# .zshrc.local) are silently treated as literal text without this
setopt extended_glob
fpath+=(/opt/homebrew/share/zsh/site-functions)
# Completions for tools installed outside Homebrew (herdr)
fpath+=("${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions")
autoload -Uz compinit
# Only regenerate completion cache once per day
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit && touch ~/.zcompdump
else
  compinit -C
fi
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' use-cache yes
zstyle ':completion:*' cache-path ~/.cache/zsh

# byte-compile the dump in the background when stale (parses ~2x faster)
{
  if [[ -s ~/.zcompdump && (! -s ~/.zcompdump.zwc || ~/.zcompdump -nt ~/.zcompdump.zwc) ]]; then
    zcompile ~/.zcompdump
  fi
} &!

# ==============================================================================
# Key Bindings
# ==============================================================================
bindkey -e                           # emacs mode
bindkey '^[[H'    beginning-of-line  # Home
bindkey '^[[1~'   beginning-of-line
bindkey '^[[F'    end-of-line        # End
bindkey '^[[4~'   end-of-line
bindkey '^[[3~'   delete-char        # Fn+Delete
bindkey '^[[1;5C' forward-word       # Ctrl+Right
bindkey '^[[1;5D' backward-word      # Ctrl+Left
bindkey '^[w'     forward-word       # Alt+w = Alt+f; adjacent on Colemak, fat-finger safe
bindkey '^[W'     forward-word

# ==============================================================================
# Eval cache
# ==============================================================================
# eval "$(tool init)" output never changes between upgrades, but spawning each
# tool costs 10-30ms. Cache the output to a file keyed by the binary's mtime —
# upgrades invalidate automatically. Delete ~/.cache/zsh-evalcache to force.
_evalcache() {
  local cmd_path=${1:c} mtime cache key
  zmodload -F zsh/stat b:zstat 2>/dev/null
  mtime=$(zstat +mtime -- "$cmd_path" 2>/dev/null) || mtime=0
  # key on the full command line — flags change a tool's init output
  key=${(j.-.)@}
  key=${key//[^A-Za-z0-9._-]/_}
  cache=$HOME/.cache/zsh-evalcache/$key.$mtime.zsh
  if [[ ! -r $cache ]]; then
    command mkdir -p $HOME/.cache/zsh-evalcache
    command rm -f $HOME/.cache/zsh-evalcache/$key.*.zsh
    "$@" > "$cache"
  fi
  source "$cache"
}

# ==============================================================================
# Version Managers
# ==============================================================================
# mise shims select the configured ruby/node version without a shell hook.
path=("${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims" $path)

# ==============================================================================
# Plugins (brew-installed, sourced directly — no plugin manager)
# ==============================================================================
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
# must come after syntax-highlighting
source /opt/homebrew/share/zsh-history-substring-search/zsh-history-substring-search.zsh
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# Forgit: use delta without side-by-side in narrow preview.
# Wrapper pins --dark (theme is always Catppuccin Mocha); delta's own
# detection would leak the OSC query reply into fzf's input.
export FORGIT_DIFF_PAGER="delta-forgit"
source /opt/homebrew/share/forgit/forgit.plugin.zsh

# ==============================================================================
# Git aliases (only the ones history says get used)
# ga/gco/gcb/gd come from forgit: bare = fzf picker, with args = plain git
# ==============================================================================
alias gst='git status'
alias gcmsg='git commit --message'

# ==============================================================================
# Modern CLI Tools
# ==============================================================================
# eza (modern ls)
if command -v eza > /dev/null; then
    export EZA_COLORS=".*=38;5;242"
    alias ls="eza --icons=always --group-directories-first"
    alias la="eza --icons=always --group-directories-first -a"
    alias ll="eza --icons=always --group-directories-first -l --header --git -h --time-style=long-iso"
    alias lla="eza --icons=always --group-directories-first -la --header --git -h --time-style=long-iso --follow-symlinks"
    alias lt="eza --icons=always --tree --level=2 --group-directories-first"
fi

# zoxide (smarter cd)
command -v zoxide > /dev/null && _evalcache zoxide init zsh && alias cd="z"

# direnv (directory-specific environment variables)
command -v direnv > /dev/null && _evalcache direnv hook zsh

# fzf key bindings and fuzzy completion
_evalcache fzf --zsh

# ==============================================================================
# Prompt (Powerlevel10k)
# ==============================================================================
# Resident zsh prompt with async git (gitstatusd) — ~1-10ms command lag vs
# ~86ms for a spawned-binary prompt. Reconfigure with `p10k configure`.
source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# ==============================================================================
# Herdr Sessionizer
# ==============================================================================
# Bind Ctrl+f at the shell prompt for quick project workspace navigation.
bindkey -s '^f' '~/bin/herdr-sessionizer\n'

# ==============================================================================
# Aliases & Local Config
# ==============================================================================
# Custom aliases
[[ -f "$HOME/.aliases" ]] && source "$HOME/.aliases"

# Local environment variables (secrets, tokens, etc.) - not tracked in git
#
# TIP: For low-friction experimentation:
#   1. Paste new config/commands into ~/.zshrc or ~/.zshrc.local directly
#   2. Test them (reload with: source ~/.zshrc)
#   3. Run 'chezmoi diff' to see what changed vs tracked version
#   4. Keep changes: 'chezmoi add ~/.zshrc' (incorporates into dotfiles)
#   5. Discard changes: 'chezmoi apply' (reverts to tracked version)
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
