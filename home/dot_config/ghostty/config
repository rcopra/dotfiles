macos-titlebar-style = hidden

theme = Catppuccin Mocha

macos-option-as-alt = true

quit-after-last-window-closed = true

# Send Alt+arrows through to tmux/Neovim pane navigation.
keybind = option+left=unbind
keybind = option+right=unbind

# Translate Cmd+Alt+up/down to tmux's Ctrl+Alt session shortcuts.
keybind = super+alt+arrow_up=csi:1;7A
keybind = super+alt+arrow_down=csi:1;7B

# Send the tmux prefix followed by its right/down split binding.
keybind = super+d=text:\x01|
keybind = super+shift+d=text:\x01-
