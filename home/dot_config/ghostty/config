macos-titlebar-style = hidden

theme = Catppuccin Mocha

macos-option-as-alt = true

quit-after-last-window-closed = true

# Send Alt+arrows through to Herdr/Neovim pane navigation.
keybind = option+left=unbind
keybind = option+right=unbind

# Unbind Ghostty's cmd+alt+up/down=goto_split so the chord passes through to
# Herdr, which binds it directly for agent navigation. Cmd+Shift+Up/Down keeps
# Ghostty's jump_to_prompt behavior.
keybind = super+alt+arrow_up=unbind
keybind = super+alt+arrow_down=unbind

# Drop Ghostty's cmd+d/cmd+shift+d=new_split so the pair reaches Herdr's own
# split_vertical/split_horizontal. Global, so bare Ghostty windows lose their
# splits too — fine when every window hosts a Herdr session.
keybind = super+d=unbind
keybind = super+shift+d=unbind
